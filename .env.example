# ─── Panchayat Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# Google Gemini API Key (Used by ArmorIQ Shield)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Required — powers all AI candidate LLM calls)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs API Key (Optional — enables TTS for candidate speeches)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ArmorIQ API Key (Required — powers the Shield election integrity engine)
ARMORIQ_API_KEY=your_armoriq_api_key_here

# Solana Devnet Private Key (Optional — enables on-chain election notarization)
# If not set, falls back to local hash ledger
# Generate with: solana-keygen new --no-bip39-passphrase
# SOLANA_PRIVATE_KEY=your_base58_encoded_private_key_here
